# Cloudflare Pages 环境变量配置示例
# 在 Cloudflare Pages 项目设置中添加这些环境变量

# 数据库配置
DATABASE_PATH=d1

# 会话管理（重要：使用强密码）
SESSION_SECRET=your-very-secure-random-string-here-please-change-this-in-production

# 开发模式
DEV_MODE=false

# 应用配置
APP_NAME=Fresh Blog
APP_URL=https://ooo-oliyo-com.pages.dev

# 安全配置
BCRYPT_ROUNDS=12

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# 性能配置
POSTS_PER_PAGE=10
SEARCH_RESULTS_PER_PAGE=20